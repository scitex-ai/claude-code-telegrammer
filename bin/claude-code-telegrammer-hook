#!/bin/bash
# claude-code-telegrammer-hook — Entry point for scitex-agent-container hooks
# Called by agent-container's post_start/pre_stop hooks.
#
# Usage:
#   claude-code-telegrammer-hook pre-start     # Write access.json (before Claude Code)
#   claude-code-telegrammer-hook post-start    # Send startup commands
#   claude-code-telegrammer-hook pre-stop      # No-op (reserved for future cleanup)

set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$SCRIPT_DIR/lib/common.sh"

# Expect these env vars from agent-container:
#   AGENT_CONFIG_PATH  — full path to agent YAML
#   AGENT_SCREEN_NAME  — screen session name
#   AGENT_NAME         — agent name

cmd="${1:-}"

case "$cmd" in
  pre-start)
    if [[ -z "${AGENT_CONFIG_PATH:-}" ]]; then
      log_warn "AGENT_CONFIG_PATH not set, skipping pre-start"
      exit 0
    fi

    # 1. Map bot_token_env → CLAUDE_CODE_TELEGRAMMER_BOT_TOKEN
    BOT_TOKEN_ENV=$(yaml_get "$AGENT_CONFIG_PATH" "spec.telegram.bot_token_env" "")
    if [[ -n "$BOT_TOKEN_ENV" && "$BOT_TOKEN_ENV" != "CLAUDE_CODE_TELEGRAMMER_BOT_TOKEN" ]]; then
      TOKEN_VAL="${!BOT_TOKEN_ENV:-}"
      if [[ -n "$TOKEN_VAL" ]]; then
        export CLAUDE_CODE_TELEGRAMMER_BOT_TOKEN="$TOKEN_VAL"
      fi
    fi

    # 2. Find telegram-server.ts: check project root first, then relative to SCRIPT_DIR
    TS_SERVER=""
    for candidate in \
      "$SCRIPT_DIR/../ts/telegram-server.ts" \
      "$SCRIPT_DIR/ts/telegram-server.ts" \
      "$(python3 -c 'import claude_code_telegrammer; import os; print(os.path.join(os.path.dirname(claude_code_telegrammer.__file__), "..", "..", "ts", "telegram-server.ts"))' 2>/dev/null)" \
    ; do
      if [[ -f "$candidate" ]]; then
        TS_SERVER="$(cd "$(dirname "$candidate")" && pwd)/$(basename "$candidate")"
        break
      fi
    done
    if [[ -z "$TS_SERVER" ]]; then
      log_warn "telegram-server.ts not found"
      exit 1
    fi

    # 3. Write access.json into the state dir that server READS it from.
    # This used to be ${CLAUDE_CODE_TELEGRAMMER_STATE_DIR:-~/.scitex/agent-container/telegram}
    # (per bot id when a token was set): a name startup refuses, defaulting to
    # a directory the server does not read. The server's own resolver answers
    # now (lib/common.sh::telegrammer_state_dir -> ts/lib/config.ts).
    AUTO_CONNECT=$(yaml_get "$AGENT_CONFIG_PATH" "spec.telegram.auto_connect" "true")
    STATE_DIR="$(telegrammer_state_dir "$(dirname "$TS_SERVER")")"
    mkdir -p "$STATE_DIR"

    # Parse allowed_users via Python (yaml_get returns flat values, not JSON)
    if [[ "$AUTO_CONNECT" == "true" || "$AUTO_CONNECT" == "True" ]]; then
      python3 -c "
import yaml, json
with open('$AGENT_CONFIG_PATH') as f:
    raw = yaml.safe_load(f)
users = raw.get('spec',{}).get('telegram',{}).get('allowed_users',[]) or []
users = [str(u) for u in users]
data = {'dmPolicy': 'allowlist', 'allowFrom': users}
with open('$STATE_DIR/access.json', 'w') as f:
    json.dump(data, f, indent=2)
    f.write('\n')
print('Wrote access.json with', len(users), 'allowed users to $STATE_DIR')
"
    fi

    # 4. Write .env for the MCP server
    echo "CLAUDE_CODE_TELEGRAMMER_BOT_TOKEN=${CLAUDE_CODE_TELEGRAMMER_BOT_TOKEN:-}" > "$STATE_DIR/.env"
    chmod 600 "$STATE_DIR/.env"
    log_info "Wrote .env to $STATE_DIR"

    # 5. Write MCP config JSON for --mcp-config
    AGENT_NAME="${AGENT_NAME:-telegrammer}"
    MCP_DIR="$HOME/.scitex/agent-container/cache/mcp-configs"
    mkdir -p "$MCP_DIR"

    # The state dir goes into the server's env ONLY when the operator set one
    # explicitly, in any accepted spelling (ts/lib/env.ts). Otherwise it is
    # left out and the server derives the same default itself, so config.ts
    # stays the single source of truth. Never the renamed
    # CLAUDE_CODE_TELEGRAMMER_STATE_DIR: startup refuses it (RENAMED_ENV in
    # ts/lib/config.ts), which made every server this hook configured exit 1.
    EXPLICIT_STATE_DIR=""
    if [[ -n "${CCT_AGENT_STATE_DIR:-}${CLAUDE_CODE_TELEGRAMMER_AGENT_STATE_DIR:-}${CLAUDE_CODE_TELEGRAMMER_TELEGRAM_AGENT_STATE_DIR:-}" ]]; then
      EXPLICIT_STATE_DIR="$STATE_DIR"
    fi

    EXPLICIT_STATE_DIR="$EXPLICIT_STATE_DIR" python3 -c "
import yaml, json, os
with open('$AGENT_CONFIG_PATH') as f:
    raw = yaml.safe_load(f)
users = raw.get('spec',{}).get('telegram',{}).get('allowed_users',[]) or []
users_str = ','.join(str(u) for u in users)
env = {
    'CLAUDE_CODE_TELEGRAMMER_BOT_TOKEN': os.environ.get('CLAUDE_CODE_TELEGRAMMER_BOT_TOKEN', ''),
    'CLAUDE_CODE_TELEGRAMMER_ALLOWED_USERS': users_str
}
if os.environ.get('EXPLICIT_STATE_DIR'):
    env['CLAUDE_CODE_TELEGRAMMER_AGENT_STATE_DIR'] = os.environ['EXPLICIT_STATE_DIR']
config = {
    'mcpServers': {
        'claude-code-telegrammer': {
            'type': 'stdio',
            'command': 'bun',
            'args': ['run', '$TS_SERVER'],
            'env': env
        }
    }
}
# Write to both /tmp (for --mcp-config) and workdir .mcp.json (for --dangerously-load-development-channels)
path = '$MCP_DIR/mcp-$AGENT_NAME.json'
with open(path, 'w') as f:
    json.dump(config, f, indent=2)
    f.write('\n')
print('Wrote MCP config to', path)

# Also write to workdir .mcp.json so --dangerously-load-development-channels can find it
import yaml as _yaml
with open('$AGENT_CONFIG_PATH') as f:
    agent_cfg = _yaml.safe_load(f)
workdir = os.path.expanduser(agent_cfg.get('spec', {}).get('workdir', '~/proj'))
mcp_json_path = os.path.join(workdir, '.mcp.json')
# Merge with existing .mcp.json if present
existing = {}
try:
    with open(mcp_json_path) as f:
        existing = json.load(f)
except (FileNotFoundError, json.JSONDecodeError):
    pass
existing.setdefault('mcpServers', {})
existing['mcpServers']['claude-code-telegrammer'] = config['mcpServers']['claude-code-telegrammer']
with open(mcp_json_path, 'w') as f:
    json.dump(existing, f, indent=2)
    f.write('\n')
print('Wrote .mcp.json to', mcp_json_path)
"
    ;;

  post-start)
    # Send startup commands (screen must exist)
    SESSION="${AGENT_SCREEN_NAME:-cld-telegram}"
    if [[ -n "${AGENT_CONFIG_PATH:-}" ]]; then
      claude-code-telegrammer-init --session "$SESSION" --config "$AGENT_CONFIG_PATH"
    fi
    ;;

  pre-stop)
    ;;

  *)
    echo "Usage: claude-code-telegrammer-hook {post-start|pre-stop}"
    exit 1
    ;;
esac
